{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shared-world-builder",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-15",
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "SharedWorld" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SharedWorld"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "shared-world.mellowpilot.com/*", "zone_name": "mellowpilot.com" }
  ]
}
